{
	"name": "barosaurus",
	"version": "1.0.0",
	"description": "One bar. Every action. Search, navigate and act on notes, commands and tabs from a single command bar.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint \"src/**/*.ts\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"fetch-ocr-assets": "node scripts/fetch-ocr-assets.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"command-palette",
		"launcher"
	],
	"author": "polygonhunter",
	"license": "MIT",
	"dependencies": {
		"fflate": "^0.8.2",
		"minisearch": "^7.1.0",
		"tesseract.js": "^6.0.1"
	},
	"devDependencies": {
		"@types/node": "^22",
		"esbuild": "0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"jsdom": "^29.1.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^3.2.4"
	}
}
